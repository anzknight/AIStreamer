# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# AITuber mode: chat | game | stream
AITUBER_MODE=chat

# TTS
TTS_ENABLED=true

# Screen Capture (for game commentary)
SCREEN_CAPTURE_ENABLED=false
SCREEN_CAPTURE_INTERVAL=10.0
GAME_WINDOW_TITLE=

# OBS WebSocket
OBS_ENABLED=false
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# YouTube Live Chat
YOUTUBE_ENABLED=false
YOUTUBE_VIDEO_ID=

# Twitch Chat
TWITCH_ENABLED=false
TWITCH_TOKEN=
TWITCH_CHANNEL=
