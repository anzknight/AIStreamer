# Groq API Key (required) - 無料: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# AITuber mode: chat | game | stream
AITUBER_MODE=chat

# TTS
TTS_ENABLED=true

# Screen Capture (for game commentary)
SCREEN_CAPTURE_ENABLED=false
SCREEN_CAPTURE_INTERVAL=10.0
GAME_WINDOW_TITLE=

# OBS WebSocket
OBS_ENABLED=false
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
# OBSのメディアソース名（YouTube配信に音声を乗せる場合）
# OBSにメディアソースを追加して名前をここに設定 例: VoiceSource
OBS_AUDIO_SOURCE=

# 自動発言（無言時間が続いた時に自動で話す）
AUTO_TALK_ENABLED=true
AUTO_TALK_INTERVAL=120

# YouTube Live Chat
YOUTUBE_ENABLED=false
YOUTUBE_VIDEO_ID=

# Twitch Chat
TWITCH_ENABLED=false
TWITCH_TOKEN=
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=

# YouTube Controller (プライバシー設定変更など)
# Google Cloud ConsoleでOAuth2認証情報を作成しconfig/youtube_client_secret.jsonに配置
YOUTUBE_CONTROLLER_ENABLED=false
